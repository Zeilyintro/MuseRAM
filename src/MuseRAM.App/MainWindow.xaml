                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="14" Text="&#xE713;"/>
                              </Button>
                            </StackPanel>
                            <Grid Grid.Column="1" Margin="0,0,10,0">
                              <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="4"/><RowDefinition Height="8"/><RowDefinition Height="12"/><RowDefinition Height="18"/><RowDefinition Height="4"/><RowDefinition Height="8"/></Grid.RowDefinitions>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="12"/>
                                  <ColumnDefinition Width="*"/>
