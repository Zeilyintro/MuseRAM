                          <ToggleButton x:Name="StableAnchorFixedButton" Style="{StaticResource StableAnchorModeButtonStyle}" Content="{DynamicResource StableAnchorFixed}" Tag="Fixed" Margin="6,0,0,0" Click="StableAnchorMode_OnClick"/>
                        </StackPanel>
                      </Grid>
                      <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="32"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                        <Canvas x:Name="StableAnchorValueCanvas" Height="24" ClipToBounds="False">
                          <TextBlock x:Name="StableAnchorValueLabel" MinWidth="58" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
