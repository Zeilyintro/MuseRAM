                    <Button x:Name="MoveProfileDownButton" Grid.Column="4" Style="{StaticResource ButtonStyle}" Content="↓" ToolTip="{DynamicResource MoveDown}" AutomationProperties.Name="{DynamicResource MoveDown}" Click="MoveProfileDown_OnClick" />
