                      </DataGridTextColumn>
                      <DataGridTextColumn Binding="{Binding InitialTrim}" Width="112" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateCenterCellTextStyle}">
                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource InitialTrim}" /></DataGridTextColumn.Header>
                      </DataGridTextColumn>
                      <DataGridTextColumn Binding="{Binding Regained}" Width="104" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateCenterCellTextStyle}">
                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource RegainedWorkingSet}" /></DataGridTextColumn.Header>
                      </DataGridTextColumn>
                      <DataGridTextColumn Binding="{Binding ReboundRate}" Width="88" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateCenterCellTextStyle}">
                        <DataGridTextColumn.Header><TextBlock Text="{DynamicResource ApplicationReboundRate}" /></DataGridTextColumn.Header>
                      </DataGridTextColumn>
                      <DataGridTextColumn Binding="{Binding Status}" Width="88" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateCenterCellTextStyle}">
