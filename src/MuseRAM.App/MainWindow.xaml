                    <ToggleButton x:Name="ReboundLimit10Button" Style="{StaticResource AnalysisFilterButtonStyle}" Margin="5,0,0,0" Tag="10" Content="10" Click="ReboundHistoryLimit_OnClick" />
                    <ToggleButton x:Name="ReboundLimit20Button" Style="{StaticResource AnalysisFilterButtonStyle}" Margin="5,0,0,0" Tag="20" Content="20" Click="ReboundHistoryLimit_OnClick" />
                    <ToggleButton x:Name="ReboundLimitAllButton" Style="{StaticResource AnalysisFilterButtonStyle}" Margin="5,0,0,0" Tag="0" Content="{DynamicResource ReboundHistoryAllShort}" Click="ReboundHistoryLimit_OnClick" />
                  </StackPanel>
