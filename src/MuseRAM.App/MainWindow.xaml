                          </Grid>
                        </StackPanel>
                        <Border Grid.Row="5" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="10" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock x:Name="StableIgnorePressureLabel" Text="{DynamicResource StableIgnorePressure}" FontWeight="SemiBold"/>
                              <TextBlock Text="{DynamicResource StableIgnorePressureHelp}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/>
                            </StackPanel>
                            <CheckBox x:Name="StableIgnorePressureCheckBox" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource StableIgnorePressure}" Checked="StableSuppressionDraftCheckBox_OnChanged" Unchecked="StableSuppressionDraftCheckBox_OnChanged"/>
                          </Grid>
                        </Border>
                      </Grid>
                      <TextBlock x:Name="CustomStableSuppressionValidationText" Foreground="{DynamicResource UltimateBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                      <Button x:Name="SaveCustomStableSuppressionButton" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" MinWidth="128" Margin="0,16,0,0" Content="{DynamicResource SaveStableSuppression}" Click="SaveCustomStableSuppression_OnClick"/>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="{DynamicResource OptimizationStrategy}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource ExtremeSafety}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,16" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource Profile}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                  <Button Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="7,0,0,0">
                    <Button.ToolTip><ToolTip Content="profile" ContentTemplate="{StaticResource ProfileHelpTemplate}" /></Button.ToolTip>
                  </Button>
                </StackPanel>
                <ComboBox x:Name="ProfileBox" Style="{StaticResource ThemedComboBoxStyle}" Margin="0,8,0,20" DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource Profile}" SelectionChanged="ProfileBox_OnSelectionChanged" />
                <CheckBox x:Name="StartupCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" Margin="0,1,0,1" Content="{DynamicResource StartWithWindows}" Checked="StartupCheckBox_OnChanged" Unchecked="StartupCheckBox_OnChanged" />
                <TextBlock Text="{DynamicResource CloseButtonSetting}" Style="{StaticResource CaptionStyle}" Margin="0,20,0,0" />
                <ComboBox x:Name="CloseBehaviorBox" Style="{StaticResource ThemedComboBoxStyle}" Margin="0,8,0,0" AutomationProperties.Name="{DynamicResource CloseButtonSetting}" SelectionChanged="CloseBehaviorBox_OnSelectionChanged">
                  <ComboBoxItem Content="{DynamicResource CloseBehaviorAsk}" Tag="Ask" />
                  <ComboBoxItem Content="{DynamicResource CloseBehaviorExit}" Tag="Exit" />
                  <ComboBoxItem Content="{DynamicResource CloseBehaviorTray}" Tag="MinimizeToTray" />
                </ComboBox>
                <Border Margin="0,18,0,0" Style="{StaticResource SettingToggleRowStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource EnhancedSafety}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="8,0,12,0">
                      <Button.ToolTip>
                        <ToolTip><TextBlock Text="{DynamicResource EnhancedSafetyDescription}" Width="340" TextWrapping="Wrap" /></ToolTip>
                      </Button.ToolTip>
                    </Button>
                    <CheckBox x:Name="EnhancedSafetyCheckBox" Grid.Column="2" Style="{StaticResource SafetyToggleStyle}"
                              AutomationProperties.Name="{DynamicResource EnhancedSafety}"
                              Checked="EnhancedSafetyCheckBox_OnChanged" Unchecked="EnhancedSafetyCheckBox_OnChanged" />
                  </Grid>
                </Border>
                <Border Margin="0,10,0,0" Style="{StaticResource SettingToggleRowStyle}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource IntelligentCandidateSelection}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="8,0,12,0">
                        <Button.ToolTip>
                          <ToolTip><TextBlock Text="{DynamicResource IntelligentCandidateSelectionDescription}" Width="340" TextWrapping="Wrap" /></ToolTip>
                        </Button.ToolTip>
                      </Button>
                      <CheckBox x:Name="IntelligentCandidateSelectionCheckBox" Grid.Column="2" Style="{StaticResource SafetyToggleStyle}"
                                AutomationProperties.Name="{DynamicResource IntelligentCandidateSelection}"
                                Checked="IntelligentCandidateSelectionCheckBox_OnChanged" Unchecked="IntelligentCandidateSelectionCheckBox_OnChanged" />
                    </Grid>
                    <TextBlock x:Name="SettingsBenefitLearningStatus" Text="{Binding BenefitLearningStatus}" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                      <Button x:Name="ClearLegacyBenefitLearningButton" Style="{StaticResource DestructiveActionButtonStyle}" Margin="0,0,16,0" Visibility="Collapsed"
                              AutomationProperties.Name="{DynamicResource ClearLegacyBenefitLearning}" Click="ClearLegacyBenefitLearning_OnClick">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{DynamicResource UltimateBrush}" Margin="0,0,8,0" Text="&#xE74D;" />
                          <TextBlock Text="{DynamicResource ClearLegacyBenefitLearning}" Foreground="{DynamicResource UltimateBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="ClearBenefitLearningButton" Style="{StaticResource DestructiveActionButtonStyle}"
                              AutomationProperties.Name="{DynamicResource ClearBenefitLearning}" Click="ClearBenefitLearning_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIconPathStyle}" Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource IconTrash}" />
                          <TextBlock Text="{DynamicResource ClearBenefitLearning}" Foreground="{DynamicResource UltimateBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Margin="0,10,0,0" Style="{StaticResource SettingToggleRowStyle}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{DynamicResource LongIdleOptimization}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="8,0,12,0"
                              AutomationProperties.Name="{DynamicResource LongIdleOptimizationHelp}">
                        <Button.ToolTip>
                          <ToolTip><TextBlock Text="{DynamicResource LongIdleOptimizationHelp}" Width="360" TextWrapping="Wrap" /></ToolTip>
                        </Button.ToolTip>
                      </Button>
                      <CheckBox x:Name="LongIdleOptimizationCheckBox" Grid.Column="2" Style="{StaticResource SafetyToggleStyle}"
                                AutomationProperties.Name="{DynamicResource LongIdleOptimization}"
                                Checked="LongIdleOptimizationCheckBox_OnChanged" Unchecked="LongIdleOptimizationCheckBox_OnChanged" />
                    </Grid>
                    <TextBlock Text="{DynamicResource LongIdleOptimizationDescription}" Style="{StaticResource CaptionStyle}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <Grid x:Name="LongIdleMinutesPanel" Margin="0,9,0,0" Visibility="Collapsed">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                      <Slider x:Name="LongIdleMinutesSlider" Style="{StaticResource EditorSliderStyle}" Minimum="30" Maximum="360" TickFrequency="10" IsSnapToTickEnabled="True"
                              AutomationProperties.Name="{DynamicResource LongIdleMinutes}"
                              ToolTip="{DynamicResource LongIdleMinutesHelp}"
                              ValueChanged="LongIdleMinutesSlider_OnValueChanged" />
                      <TextBlock x:Name="LongIdleMinutesText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                      <TextBlock x:Name="LongIdleStatusText" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CaptionStyle}"
                                 Margin="0,7,0,0" TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
                <StackPanel Grid.Row="2" Margin="14,18,14,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource CurrentVersion}" FontWeight="SemiBold" />
                    <TextBlock x:Name="LatestVersionText" Margin="16,0,0,0" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Tagline}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="{DynamicResource AppearanceMaintenance}" FontSize="18" FontWeight="SemiBold" />
                <Border Style="{StaticResource SettingToggleRowStyle}" Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource FollowSystemTheme}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox x:Name="FollowSystemThemeCheckBox" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}"
                              AutomationProperties.Name="{DynamicResource FollowSystemTheme}"
                              Checked="FollowSystemThemeCheckBox_OnChanged" Unchecked="FollowSystemThemeCheckBox_OnChanged" />
                  </Grid>
                </Border>
                <Border Margin="0,8,0,0" Style="{StaticResource SettingToggleRowStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource TrayMemoryUsageIcon}" FontWeight="SemiBold" />
                      <TextBlock Text="{DynamicResource TrayMemoryUsageIconDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,8,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox x:Name="TrayMemoryUsageIconCheckBox" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}"
                              AutomationProperties.Name="{DynamicResource TrayMemoryUsageIcon}"
                              Checked="TrayMemoryUsageIconCheckBox_OnChanged" Unchecked="TrayMemoryUsageIconCheckBox_OnChanged" />
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="ThemeButton" Style="{StaticResource CommandButtonStyle}" Click="Theme_OnClick">
                    <StackPanel Orientation="Horizontal"><Path x:Name="ThemeButtonIcon" Style="{StaticResource ThemeIconPathStyle}" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource IconSun}"/><TextBlock Text="{DynamicResource ToggleTheme}" VerticalAlignment="Center"/></StackPanel>
                  </Button>
                  <Grid Margin="10,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <Button x:Name="CheckUpdateButton" Style="{StaticResource CommandButtonStyle}" Click="CheckUpdate_OnClick" Margin="0">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Path Style="{StaticResource ButtonIconPathStyle}" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource IconRefresh}"/><TextBlock Grid.Column="1" Text="{DynamicResource CheckUpdates}" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button x:Name="UpdateFrequencyMenuButton" Grid.Column="1" Style="{StaticResource ExpandCommandButtonStyle}" Width="34" Height="34" Margin="0"
                            ToolTip="{DynamicResource UpdateFrequency}" AutomationProperties.Name="{DynamicResource UpdateFrequency}"
                            PreviewMouseLeftButtonDown="ManagedPopupTrigger_OnPreviewMouseLeftButtonDown" Click="UpdateFrequencyMenuButton_OnClick">
                      <Path Style="{StaticResource ButtonIconPathStyle}" Width="14" Height="14" Data="{StaticResource IconChevronDown}" />
                    </Button>
                    <Popup x:Name="UpdateFrequencyPopup" Style="{StaticResource FadePopupStyle}" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=UpdateFrequencyMenuButton}" StaysOpen="True" AllowsTransparency="True"
                           VerticalOffset="6" Closed="UpdateFrequencyPopup_OnClosed">
                      <Border MinWidth="176" Padding="6" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                          <Button Tag="EveryStartup" Content="{DynamicResource UpdateEveryStartup}" Style="{StaticResource PopupMenuButtonStyle}" Click="UpdateFrequencyOption_OnClick" />
                          <Button Tag="Daily" Content="{DynamicResource UpdateDaily}" Style="{StaticResource PopupMenuButtonStyle}" Click="UpdateFrequencyOption_OnClick" />
                          <Button Tag="Weekly" Content="{DynamicResource UpdateWeekly}" Style="{StaticResource PopupMenuButtonStyle}" Click="UpdateFrequencyOption_OnClick" />
                          <Button Tag="ManualOnly" Content="{DynamicResource UpdateManualOnly}" Style="{StaticResource PopupMenuButtonStyle}" Click="UpdateFrequencyOption_OnClick" />
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </StackPanel>
                <TextBlock Text="{DynamicResource Language}" Style="{StaticResource CaptionStyle}" Margin="0,12,0,0" />
                <ComboBox x:Name="LanguageBox" Style="{StaticResource ThemedComboBoxStyle}" Margin="0,6,0,1" DisplayMemberPath="DisplayName" AutomationProperties.Name="{DynamicResource Language}" SelectionChanged="LanguageBox_OnSelectionChanged" />
                <TextBlock Text="{DynamicResource UpdateUnavailable}" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource SelfOverhead}" Style="{StaticResource CaptionStyle}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding SelfOverhead}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <Border Margin="0,12,0,0" Style="{StaticResource SettingToggleRowStyle}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource RuntimeProgressPersistence}" FontWeight="SemiBold" />
                      <TextBlock Text="{DynamicResource RuntimeProgressPersistenceDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,8,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="8,0,12,0">
                      <Button.ToolTip>
                        <ToolTip><TextBlock Text="{DynamicResource RuntimeProgressPersistenceHelp}" Width="360" TextWrapping="Wrap" /></ToolTip>
                      </Button.ToolTip>
                    </Button>
                    <CheckBox x:Name="RuntimeProgressPersistenceCheckBox" Grid.Column="2" Style="{StaticResource SafetyToggleStyle}"
                              AutomationProperties.Name="{DynamicResource RuntimeProgressPersistence}"
                              Checked="RuntimeProgressPersistenceCheckBox_OnChanged" Unchecked="RuntimeProgressPersistenceCheckBox_OnChanged" />
                  </Grid>
                </Border>
                <Border Margin="0,8,0,0" Style="{StaticResource SettingToggleRowStyle}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource DiagnosticDataCollection}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource DiagnosticDataCollectionDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,8,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="8,0,12,0">
                        <Button.ToolTip>
                          <ToolTip><TextBlock Text="{DynamicResource DiagnosticDataCollectionHelp}" Width="360" TextWrapping="Wrap" /></ToolTip>
                        </Button.ToolTip>
                      </Button>
                      <CheckBox x:Name="DiagnosticDataCollectionCheckBox" Grid.Column="2" Style="{StaticResource SafetyToggleStyle}"
                                AutomationProperties.Name="{DynamicResource DiagnosticDataCollection}"
                                Checked="DiagnosticDataCollectionCheckBox_OnChanged" Unchecked="DiagnosticDataCollectionCheckBox_OnChanged" />
                    </Grid>
                    <Button x:Name="ClearDiagnosticDataButton" Style="{StaticResource DestructiveActionButtonStyle}" Margin="0,9,0,0"
                            AutomationProperties.Name="{DynamicResource ClearDiagnosticData}" Click="ClearDiagnosticData_OnClick">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIconPathStyle}" Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource IconTrash}" />
                        <TextBlock Text="{DynamicResource ClearDiagnosticData}" Foreground="{DynamicResource UltimateBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource LocalData}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6" />
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource SettingsAndCustomProfilesData}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,6" />
                  <TextBlock Grid.Column="1" Text=".\settings.json" Style="{StaticResource CaptionStyle}" ToolTip="{DynamicResource ProgramDirectoryPathHelp}" />
                  <TextBlock Grid.Row="1" Text="{DynamicResource BenefitLearningData}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text=".\benefit-learning.json" Style="{StaticResource CaptionStyle}" ToolTip="{DynamicResource ProgramDirectoryPathHelp}" />
                  <TextBlock Grid.Row="2" Text="{DynamicResource RuntimeProgressData}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text=".\runtime-state.json" Style="{StaticResource CaptionStyle}" ToolTip="{DynamicResource ProgramDirectoryPathHelp}" />
                  <TextBlock Grid.Row="3" Text="{DynamicResource ActivityHistory}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text=".\history.json" Style="{StaticResource CaptionStyle}" ToolTip="{DynamicResource ProgramDirectoryPathHelp}" />
                  <TextBlock Grid.Row="4" Text="{DynamicResource ReboundHistory}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text=".\rebound-history.json" Style="{StaticResource CaptionStyle}" ToolTip="{DynamicResource ProgramDirectoryPathHelp}" />
                  <TextBlock Grid.Row="5" Text="{DynamicResource DiagnosticCalibrationData}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,6" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Text=".\diagnostics\calibration-metrics.jsonl" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{DynamicResource DiagnosticFilesHelp}" />
                  <TextBlock Grid.Row="6" Text="{DynamicResource DiagnosticLogData}" Style="{StaticResource CaptionStyle}" Margin="0,0,10,0" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Text=".\diagnostics\museram.log" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{DynamicResource DiagnosticFilesHelp}" />
                </Grid>
                <Button x:Name="OpenDataFolderButton" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,6" Click="OpenDataFolder_OnClick">
                  <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ButtonIconPathStyle}" Width="16" Height="16" Margin="0,0,8,0" Data="{StaticResource IconFolderOpen}"/><TextBlock Text="{DynamicResource OpenDataFolder}" VerticalAlignment="Center"/></StackPanel>
                </Button>
              </StackPanel>
              </Border>
            </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Border x:Name="CompactShell" Visibility="Collapsed" Margin="10" Padding="14" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="MuseRAM" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Tagline}" Style="{StaticResource CaptionStyle}" Margin="0,2,12,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="CompactThemeButton" Style="{StaticResource ButtonStyle}" Width="38" Height="38" Padding="0"
                    Margin="0,0,10,0" ToolTip="{DynamicResource ToggleTheme}" AutomationProperties.Name="{DynamicResource ToggleTheme}" Click="Theme_OnClick">
              <Path x:Name="CompactThemeIcon" Style="{StaticResource ThemeIconPathStyle}" Width="18" Height="18" Data="{StaticResource IconSun}" />
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource SwitchToFullConsole}"
                    AutomationProperties.Name="{DynamicResource SwitchToFullConsole}" Click="CompactMode_OnClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ButtonIconPathStyle}" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource IconExpand}"/><TextBlock Text="{DynamicResource FullConsole}" VerticalAlignment="Center"/></StackPanel></Button>
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="10,6">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="34"/></Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource MemoryUsage}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Grid.Row="1" Text="{Binding MemoryUsage}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="34"/></Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource AvailableMemory}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Grid.Row="1" Text="{Binding AvailableMemory}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="34"/></Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource AutoOptimize}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Grid.Row="1" Text="{Binding AutoStatus}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="34"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Profile}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                <Button Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="7,0,0,0">
                  <Button.ToolTip><ToolTip Content="profile" ContentTemplate="{StaticResource ProfileHelpTemplate}" /></Button.ToolTip>
                </Button>
              </StackPanel>
              <ComboBox x:Name="CompactProfileBox" Grid.Row="1" Style="{StaticResource ThemedComboBoxStyle}" Width="148" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource Profile}" SelectionChanged="ProfileBox_OnSelectionChanged" />
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="104"/><ColumnDefinition Width="8"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextAlignment="Center" />
          <Button x:Name="CompactOptimizeNowButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource OptimizeNow}" Click="OptimizeNow_OnClick" />
          <Border Grid.Column="4" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource AutoOptimize}" VerticalAlignment="Center" FontWeight="SemiBold" />
              <CheckBox x:Name="CompactAutoToggle" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource AutoOptimize}" Checked="CompactAutoToggle_OnChanged" Unchecked="CompactAutoToggle_OnChanged" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</Window>
