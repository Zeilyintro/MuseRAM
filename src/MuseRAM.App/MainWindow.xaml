                  <TextBlock Grid.Column="4" Text="{DynamicResource ProtectionSuggestionStatus}" Style="{StaticResource AnalysisHeaderTextStyle}" HorizontalAlignment="Stretch" TextAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{DynamicResource LearningActions}" Style="{StaticResource AnalysisHeaderTextStyle}" HorizontalAlignment="Stretch" TextAlignment="Center" />
