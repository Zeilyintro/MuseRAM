                        <Slider x:Name="StableAnchorSlider" Grid.Row="1" Style="{StaticResource EditorSliderStyle}" TickFrequency="1" IsSnapToTickEnabled="True"
                                AutomationProperties.Name="{DynamicResource StableAnchorValue}" ValueChanged="StableAnchorSlider_OnValueChanged" SizeChanged="StableAnchorSlider_OnSizeChanged"/>
                        <Grid Grid.Row="2">
                          <TextBlock x:Name="StableAnchorMinimumLabel" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Left"/>
                          <TextBlock x:Name="StableAnchorMaximumLabel" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                      </Grid>
                      <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="StableAnchorResetButton" Grid.Column="0" Style="{StaticResource ButtonStyle}" MinWidth="154" Padding="12,0"
                                Content="{DynamicResource StableAnchorResetLearning}" Click="StableAnchorResetLearning_OnClick"/>
                        <Button Grid.Column="2" Style="{StaticResource ButtonStyle}" MinWidth="64" Padding="14,0" Content="{DynamicResource Cancel}" Click="StableAnchorCancel_OnClick"/>
                        <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" MinWidth="64" Padding="14,0" Margin="8,0,0,0" Content="{DynamicResource Apply}" Click="StableAnchorApply_OnClick"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="CustomPage" Visibility="Collapsed">
