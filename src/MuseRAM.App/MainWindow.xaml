    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
              <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="True">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource NavigationHoverBrush}" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                  <Condition Binding="{Binding Path=(local:InputModality.IsKeyboardMode), RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
              </MultiDataTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="TitleBar" Visibility="Collapsed" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <Image Source="Assets/MuseRAM.ico" Width="18" Height="18" Margin="0,0,8,0" />
          <TextBlock Text="MuseRAM" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource TitleBarButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_OnClick"
                  ToolTip="{DynamicResource MinimizeWindow}" AutomationProperties.Name="{DynamicResource MinimizeWindow}">
            <Path Style="{StaticResource ButtonIconPathStyle}" Width="15" Height="15" Data="{StaticResource IconMinimize}" />
          </Button>
          <Button x:Name="MaximizeRestoreButton" Style="{StaticResource TitleBarButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeRestore_OnClick"
                  ToolTip="{DynamicResource MaximizeWindow}" AutomationProperties.Name="{DynamicResource MaximizeWindow}">
            <Path x:Name="MaximizeRestoreIcon" Style="{StaticResource ButtonIconPathStyle}" Width="15" Height="15" Data="{StaticResource IconMaximize}" />
          </Button>
          <Button Style="{StaticResource TitleBarButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_OnClick"
                  ToolTip="{DynamicResource CloseWindow}" AutomationProperties.Name="{DynamicResource CloseWindow}">
            <Path Style="{StaticResource ButtonIconPathStyle}" Width="15" Height="15" Data="{StaticResource IconClose}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
    <Grid x:Name="FullShell">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="0,18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource BrandLogoBrush}" BorderBrush="{DynamicResource BrandLogoBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
            <TextBlock Text="M" Foreground="{DynamicResource BrandLogoTextBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ToggleButton x:Name="OverviewNav" Style="{StaticResource NavButtonStyle}" Tag="OverviewPage" ToolTip="{DynamicResource Overview}" AutomationProperties.Name="{DynamicResource Overview}" Click="Nav_OnClick"><Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconDashboard}" /></ToggleButton>
            <ToggleButton x:Name="ProcessesNav" Style="{StaticResource NavButtonStyle}" Tag="ProcessesPage" ToolTip="{DynamicResource Processes}" AutomationProperties.Name="{DynamicResource Processes}" Click="Nav_OnClick"><Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconActivity}" /></ToggleButton>
            <ToggleButton x:Name="ProtectionNav" Style="{StaticResource NavButtonStyle}" Tag="ProtectionPage" ToolTip="{DynamicResource Protection}" AutomationProperties.Name="{DynamicResource Protection}" Click="Nav_OnClick"><Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconShield}" /></ToggleButton>
            <ToggleButton x:Name="ApplicationRulesNav" Style="{StaticResource NavButtonStyle}" Tag="ApplicationRulesPage" ToolTip="{DynamicResource ApplicationRules}" AutomationProperties.Name="{DynamicResource ApplicationRules}" Click="Nav_OnClick"><Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconListChecks}" /></ToggleButton>
            <ToggleButton x:Name="HistoryNav" Style="{StaticResource NavButtonStyle}" Tag="HistoryPage" ToolTip="{DynamicResource History}" AutomationProperties.Name="{DynamicResource History}" Click="Nav_OnClick"><Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconHistory}" /></ToggleButton>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <ToggleButton x:Name="CustomNav" Style="{StaticResource NavButtonStyle}" Tag="CustomPage" ToolTip="{DynamicResource Custom}" AutomationProperties.Name="{DynamicResource Custom}" Click="Nav_OnClick"><Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSliders}" /></ToggleButton>
            <ToggleButton x:Name="SettingsNav" Style="{StaticResource NavButtonStyle}" Tag="SettingsPage" ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}" Click="Nav_OnClick"><Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSettings}" /></ToggleButton>
            <Button x:Name="FullModeNavigationButton" Style="{StaticResource ModeToggleButtonStyle}"
                    ToolTip="{DynamicResource SwitchToCompactMode}" AutomationProperties.Name="{DynamicResource SwitchToCompactMode}"
                    Click="CompactMode_OnClick"><Path Style="{StaticResource ButtonIconPathStyle}" Width="19" Height="19" Data="{StaticResource IconShrink}" /></Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="24,18,24,22">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="{DynamicResource Overview}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Tagline}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Padding="12,7" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" MaxWidth="340" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Border>
            <Button x:Name="QuickThemeButton" Style="{StaticResource ButtonStyle}" Width="38" Height="38" Padding="0"
                    Margin="0,0,10,0" ToolTip="{DynamicResource ToggleTheme}" AutomationProperties.Name="{DynamicResource ToggleTheme}" Click="Theme_OnClick">
              <Path x:Name="QuickThemeIcon" Style="{StaticResource ThemeIconPathStyle}" Width="18" Height="18" Data="{StaticResource IconSun}" />
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="{DynamicResource SwitchToCompactMode}"
                    AutomationProperties.Name="{DynamicResource SwitchToCompactMode}" Click="CompactMode_OnClick">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ButtonIconPathStyle}" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource IconShrink}"/><TextBlock Text="{DynamicResource CompactMode}" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid x:Name="OverviewPage">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="1.15*"/><RowDefinition Height="16"/><RowDefinition Height="0.85*"/></Grid.RowDefinitions>

            <Border x:Name="MemoryTrendCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource MemoryTrend}" FontSize="17" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,14,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource MemoryChange}" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding MemoryChange}" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,7" />
                    <TextBlock Text="{DynamicResource ComparedWithPreviousSample}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Recent60Seconds}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                    <local:MemoryHistoryChart x:Name="MemoryChart" Grid.Row="1" Margin="0,10,0,0" MinHeight="105"
                                              BarBrush="{DynamicResource AccentSoftBrush}"
                                              ActiveBarBrush="{DynamicResource AccentBrush}"
                                              GridBrush="{DynamicResource BorderBrush}" />
                  </Grid>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"><TextBlock Text="{DynamicResource RecentTrim}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding RecentTrim}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource CumulativeTrim}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding CumulativeTrim}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource BoostNetGain}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding BoostNetGain}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                  <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource CumulativeNetGain}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding CumulativeNetGain}" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding SelfOverhead}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,7,0,0">
                  <TextBlock Text="{DynamicResource LastUpdated}" Style="{StaticResource CaptionStyle}" />
                  <TextBlock Text=": " Style="{StaticResource CaptionStyle}" />
                  <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource CaptionStyle}" />
                  <Border Width="1" Height="12" Margin="12,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
                  <TextBlock Text="{DynamicResource SessionUptime}" Style="{StaticResource CaptionStyle}" />
                  <TextBlock Text=": " Style="{StaticResource CaptionStyle}" />
                  <TextBlock Text="{Binding SessionUptime}" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource OptimizationCenter}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button x:Name="ProtectionSuggestionButton" Grid.Column="1" Style="{StaticResource ProtectionSuggestionButtonStyle}"
                          MaxWidth="190" Margin="12,0,0,0" IsEnabled="False"
                          AutomationProperties.Name="{DynamicResource ProtectionSuggestions}"
                          Click="ProtectionSuggestions_OnClick">
                    <Grid ClipToBounds="True">
                      <TextBlock x:Name="ProtectionSuggestionButtonText" Text="{DynamicResource ProtectionSuggestionsNone}"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="ProtectionSuggestionShimmer" Text="{Binding Text, ElementName=ProtectionSuggestionButtonText}"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Opacity="0" IsHitTestVisible="False">
                        <TextBlock.Foreground>
                          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.RelativeTransform>
                              <TranslateTransform x:Name="ProtectionSuggestionShimmerTransform" X="-1.2" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop x:Name="ProtectionSuggestionShimmerStart" Color="#00000000" Offset="0.38" />
                            <GradientStop x:Name="ProtectionSuggestionShimmerCenter" Color="#E6000000" Offset="0.5" />
                            <GradientStop x:Name="ProtectionSuggestionShimmerEnd" Color="#00000000" Offset="0.62" />
                          </LinearGradientBrush>
                        </TextBlock.Foreground>
                      </TextBlock>
                    </Grid>
                  </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource Profile}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="7,0,0,0">
                    <Button.ToolTip><ToolTip Content="profile" ContentTemplate="{StaticResource ProfileHelpTemplate}" /></Button.ToolTip>
                  </Button>
                  <ComboBox x:Name="OverviewProfileBox" Grid.Column="2" Style="{StaticResource ThemedComboBoxStyle}" Width="142" HorizontalAlignment="Right" DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource Profile}" SelectionChanged="ProfileBox_OnSelectionChanged" />
                </Grid>
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource CurrentStatus}" Style="{StaticResource CaptionStyle}" />
                  <TextBlock Text="{Binding LastResult}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ReboundRate}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ReboundSummary}" Style="{StaticResource CaptionStyle}" Margin="12,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ReboundDetailsButton" Grid.Column="2" Style="{StaticResource InlineActionButtonStyle}" Content="{DynamicResource ReboundDetails}" IsEnabled="{Binding HasReboundDetails}" Click="ReboundDetails_OnClick" />
                  </Grid>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                      <Border Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                          <Button x:Name="OptimizeNowButton" Tag="Left" Style="{StaticResource PrimarySplitButtonStyle}" Content="{DynamicResource OptimizeNow}" Click="OptimizeNow_OnClick" />
                          <Border Grid.Column="1" Background="{DynamicResource AccentPressedBrush}" Margin="0,7" />
                          <Button x:Name="ScheduleMenuButton" Grid.Column="2" Tag="Right" Style="{StaticResource PrimarySplitButtonStyle}" Padding="0" ToolTip="{DynamicResource ScheduledOptimization}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{DynamicResource ScheduledOptimization}" PreviewMouseLeftButtonDown="ManagedPopupTrigger_OnPreviewMouseLeftButtonDown" Click="ScheduleMenuButton_OnClick">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE70D;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                          </Button>
                        </Grid>
                      </Border>
                      <Popup x:Name="SchedulePopup" Style="{StaticResource FadePopupStyle}" Placement="Bottom" PlacementTarget="{Binding ElementName=ScheduleMenuButton}" StaysOpen="True" AllowsTransparency="True" VerticalOffset="6" Closed="SchedulePopup_OnClosed">
                        <Border Width="270" Padding="14" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{DynamicResource ScheduledOptimization}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <CheckBox x:Name="ScheduledOptimizationCheckBox" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{DynamicResource ScheduledOptimization}"
                                        Checked="ScheduledOptimizationCheckBox_OnChanged" Unchecked="ScheduledOptimizationCheckBox_OnChanged" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{DynamicResource ScheduledInterval}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                              <ComboBox x:Name="ScheduledOptimizationIntervalBox" Grid.Column="1" Style="{StaticResource ThemedComboBoxStyle}" AutomationProperties.Name="{DynamicResource ScheduledInterval}" SelectionChanged="ScheduledOptimizationIntervalBox_OnSelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Scheduled1Minute}" Tag="1" />
                                <ComboBoxItem Content="{DynamicResource Scheduled2Minutes}" Tag="2" />
                                <ComboBoxItem Content="{DynamicResource Scheduled5Minutes}" Tag="5" />
                                <ComboBoxItem Content="{DynamicResource Scheduled10Minutes}" Tag="10" />
                                <ComboBoxItem Content="{DynamicResource Scheduled15Minutes}" Tag="15" />
                                <ComboBoxItem Content="{DynamicResource Scheduled30Minutes}" Tag="30" />
                                <ComboBoxItem Content="{DynamicResource Scheduled60Minutes}" Tag="60" />
                                <ComboBoxItem Content="{DynamicResource ScheduledCustom}" Tag="custom" />
                              </ComboBox>
                            </Grid>
                            <Grid x:Name="ScheduledCustomIntervalPanel" Margin="0,10,0,0" Visibility="Collapsed">
                              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/><ColumnDefinition Width="8"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{DynamicResource ScheduledCustomMinutes}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                              <TextBox x:Name="ScheduledCustomIntervalTextBox" Grid.Column="1" Style="{StaticResource EditorTextBoxStyle}" Padding="7,4" MaxLength="4" AutomationProperties.Name="{DynamicResource ScheduledCustomMinutes}" KeyDown="ScheduledCustomIntervalTextBox_OnKeyDown" />
                              <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Padding="8,4" Content="{DynamicResource Apply}" Click="ScheduledCustomIntervalApply_OnClick" />
                            </Grid>
                            <TextBlock x:Name="ScheduledCustomIntervalValidationText" Style="{StaticResource CaptionStyle}" Foreground="{DynamicResource UltimateBrush}" Margin="0,6,0,0" Visibility="Collapsed" Text="{DynamicResource ScheduledCustomRange}" />
                          </StackPanel>
                        </Border>
                      </Popup>
                    </Grid>
                    <Grid Grid.Column="2">
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource AutoOptimizeShort}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <CheckBox x:Name="AutoToggle" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource AutoOptimize}" Checked="AutoToggle_OnChanged" Unchecked="AutoToggle_OnChanged" />
                        <Button x:Name="CandidateModeMenuButton" Grid.Column="2" Style="{StaticResource PopupTriggerButtonStyle}" Width="26" Height="28" Padding="0" Margin="4,0,0,0"
                                Background="Transparent" BorderThickness="0" ToolTip="{DynamicResource CandidateMode}" AutomationProperties.Name="{DynamicResource CandidateMode}"
                                PreviewMouseLeftButtonDown="ManagedPopupTrigger_OnPreviewMouseLeftButtonDown" Click="CandidateModeMenuButton_OnClick">
                          <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE70D;" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                      </Grid>
                    </Border>
                    <Popup x:Name="CandidateModePopup" Style="{StaticResource FadePopupStyle}" Placement="Bottom" PlacementTarget="{Binding ElementName=CandidateModeMenuButton}" StaysOpen="True" AllowsTransparency="True" VerticalOffset="6" Closed="CandidateModePopup_OnClosed">
                      <Border Width="132" Padding="6" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                          <Button x:Name="StandardCandidateModeButton" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="8,3" HorizontalContentAlignment="Stretch" ToolTip="{DynamicResource StandardCandidateModeHelp}" Click="StandardCandidateMode_OnClick">
                            <Grid>
                              <TextBlock x:Name="StandardCandidateModeCheck" FontFamily="{StaticResource IconFontFamily}" Text="&#xE73E;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" />
                              <TextBlock Text="{DynamicResource StandardCandidateMode}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                          <Button x:Name="QuickCandidateModeButton" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="8,3" HorizontalContentAlignment="Stretch" Margin="0,3,0,0" ToolTip="{DynamicResource QuickCandidateModeHelp}" Click="QuickCandidateMode_OnClick">
                            <Grid>
                              <TextBlock x:Name="QuickCandidateModeCheck" FontFamily="{StaticResource IconFontFamily}" Text="&#xE73E;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" />
                              <TextBlock Text="{DynamicResource QuickCandidateMode}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </StackPanel>
                      </Border>
                    </Popup>
                    </Grid>
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="40">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource IntelligentCandidateSelection}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <CheckBox x:Name="OverviewBenefitLearningCheckBox" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource IntelligentCandidateSelection}"
                                  Checked="OverviewBenefitLearningCheckBox_OnChanged" Unchecked="OverviewBenefitLearningCheckBox_OnChanged" />
                      </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="40">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource IgnoreMemoryPressureShort}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <CheckBox x:Name="IgnoreMemoryPressureThresholdCheckBox" Grid.Column="1" Style="{StaticResource SafetyToggleStyle}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource IgnoreMemoryPressureShort}"
                                  ToolTip="{DynamicResource IgnoreMemoryPressureHelp}"
                                  Checked="IgnoreMemoryPressureThresholdCheckBox_OnChanged" Unchecked="IgnoreMemoryPressureThresholdCheckBox_OnChanged" />
                      </Grid>
                    </Border>
                  </Grid>
                  <Border x:Name="OverviewStableSuppressionRow" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Padding="0" Height="38">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource StableStateSuppression}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ProfileHelpButtonStyle}" Content="?" Margin="7,0,0,0" ToolTip="{DynamicResource StableStateSuppressionHelp}" />
                      </StackPanel>
                      <ComboBox x:Name="OverviewStableStateSuppressionModeBox" Grid.Column="1" Style="{StaticResource ThemedComboBoxStyle}"
                                Height="36" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource StableStateSuppression}"
                                ToolTipService.ShowOnDisabled="True" DisplayMemberPath="Name"
                                SelectionChanged="OverviewStableStateSuppressionModeBox_OnSelectionChanged">
                      </ComboBox>
                    </Grid>
                  </Border>
                </StackPanel>
                <Button x:Name="DeepReleaseButton" Grid.Row="3" Style="{StaticResource DangerButtonStyle}"
                        Height="30" Padding="14,0" Margin="0,12,0,0"
                        HorizontalAlignment="Stretch" Content="{DynamicResource DeepRelease}" Click="DeepRelease_OnClick" />
              </Grid>
            </Border>

            <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource SafeCandidates}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{DynamicResource CandidateDescription}"/>
                  <Button x:Name="CandidateDisplayMenuButton" Grid.Column="1" Style="{StaticResource PopupTriggerButtonStyle}" Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                          Background="Transparent" BorderThickness="0" ToolTip="{DynamicResource CandidateDisplayLimitHelp}" AutomationProperties.Name="{DynamicResource CandidateDisplayLimit}"
                          Click="CandidateDisplayMenuButton_OnClick">
                      <TextBlock FontFamily="{StaticResource IconFontFamily}" Text="&#xE70D;" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                  <Popup x:Name="CandidateDisplayPopup" Grid.Column="1" Placement="Bottom" PlacementTarget="{Binding ElementName=CandidateDisplayMenuButton}" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" Closed="CandidateDisplayPopup_OnClosed">
                    <Border Width="132" Padding="6" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                      <StackPanel>
                    <Button x:Name="CandidateDisplay10Button" Tag="10" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="8,3" HorizontalContentAlignment="Stretch" Click="CandidateDisplayLimit_OnClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CandidateDisplay10Check" FontFamily="{StaticResource IconFontFamily}" Text="&#xE73E;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="10" VerticalAlignment="Center"/></Grid></Button>
                    <Button x:Name="CandidateDisplay20Button" Tag="20" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="8,3" HorizontalContentAlignment="Stretch" Margin="0,3,0,0" Click="CandidateDisplayLimit_OnClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CandidateDisplay20Check" FontFamily="{StaticResource IconFontFamily}" Text="&#xE73E;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="20" VerticalAlignment="Center"/></Grid></Button>
                    <Button x:Name="CandidateDisplay40Button" Tag="40" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="8,3" HorizontalContentAlignment="Stretch" Margin="0,3,0,0" Click="CandidateDisplayLimit_OnClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CandidateDisplay40Check" FontFamily="{StaticResource IconFontFamily}" Text="&#xE73E;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="40" VerticalAlignment="Center"/></Grid></Button>
                    <Button x:Name="CandidateDisplayUnlimitedButton" Tag="0" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="8,3" HorizontalContentAlignment="Stretch" Margin="0,3,0,0" Click="CandidateDisplayLimit_OnClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CandidateDisplayUnlimitedCheck" FontFamily="{StaticResource IconFontFamily}" Text="&#xE73E;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{DynamicResource CandidateDisplayUnlimited}" VerticalAlignment="Center"/></Grid></Button>
                      </StackPanel>
                    </Border>
                  </Popup>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding CandidateSorting}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </Grid>
                <DataGrid x:Name="CandidatesGrid" Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Candidates}" MaxHeight="280"
                          IsReadOnly="True" SelectionMode="Single" AutomationProperties.Name="{DynamicResource SafeCandidates}"
                          PreviewMouseRightButtonDown="CandidatesGrid_OnPreviewMouseRightButtonDown">
                  <DataGrid.ContextMenu>
                    <ContextMenu x:Name="CandidatesContextMenu" Opened="CandidatesContextMenu_OnOpened" Closed="CandidatesContextMenu_OnClosed"
                                 Style="{StaticResource ThemedContextMenuStyle}">
                      <MenuItem x:Name="OptimizeCandidateMenuItem" Style="{StaticResource ThemedMenuItemStyle}"
                                Header="{DynamicResource OptimizeThisApplication}" Click="OptimizeCandidate_OnClick" />
                      <MenuItem x:Name="ProtectCandidateMenuItem" Style="{StaticResource ThemedMenuItemStyle}"
                                Header="{DynamicResource AddApplicationToProtection}" Click="ProtectCandidate_OnClick" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Width="1.55*" MinWidth="120" HeaderStyle="{StaticResource CandidateLeftHeaderStyle}" ElementStyle="{StaticResource CandidateLeftCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Application}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Memory}" Width="1.35*" MinWidth="130" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateMemoryCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource CandidateMemory}" ToolTip="{DynamicResource CandidateMemoryHelp}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTemplateColumn Width="1.45*" MinWidth="130" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}">
                      <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource IdleStatusColumn}" /></DataGridTemplateColumn.Header>
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding IdleStatusDetail}"><ContentPresenter Style="{StaticResource RetentionStatusIconPresenterStyle}" Visibility="{Binding HasRetentionIcon, Converter={StaticResource BooleanToVisibilityConverter}}" Content="{Binding}" ContentTemplate="{StaticResource RetentionStatusIconTemplate}" /><TextBlock Text="{Binding IdleStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Ranking}" Width="1.15*" MinWidth="110" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateCenterCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource CandidateBenefitLearning}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding AutoOptimizationStatus}" Width="1.5*" MinWidth="120" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateCenterCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource AutoOptimization}" ToolTip="{DynamicResource AutoOptimizationStatusHelp}" /></DataGridTextColumn.Header></DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource MemoryUsage}" FontSize="17" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,8">
                  <local:MemoryGauge Value="{Binding MemoryLoadPercent}"
                                     Label="{DynamicResource PhysicalMemory}"
                                     AccentBrush="{DynamicResource AccentBrush}"
                                     SuccessBrush="{DynamicResource SuccessBrush}"
                                     WarningBrush="{DynamicResource WarningBrush}"
                                     TrackBrush="{DynamicResource BorderBrush}"
                                     TextBrush="{DynamicResource TextBrush}"
                                     MutedBrush="{DynamicResource MutedBrush}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <TextBlock Text="{DynamicResource Available}" FontSize="15" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text=" " FontSize="15" />
                    <TextBlock Text="{Binding AvailableMemory}" FontSize="15" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource PhysicalMemory}" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding PhysicalMemorySummary}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  </Grid>
                  <ProgressBar Grid.Row="1" Style="{StaticResource MemoryBarStyle}" Height="5" Value="{Binding MemoryLoadPercent}" Margin="0,4,0,0"
                               AutomationProperties.Name="{DynamicResource PhysicalMemory}" />
                </Grid>
                <Grid Grid.Row="3" Margin="0,7,0,0" ToolTip="{DynamicResource VirtualMemoryCommitHelp}">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource VirtualMemoryCommit}" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding CommittedMemorySummary}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  </Grid>
                  <ProgressBar Grid.Row="1" Style="{StaticResource MemoryBarStyle}" Height="5" Value="{Binding CommitLoadPercent}" Margin="0,4,0,0"
                               AutomationProperties.Name="{DynamicResource VirtualMemoryCommit}" />
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="ProcessesPage" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="{DynamicResource RunningApplications}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ProcessDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_OnClick"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ButtonIconPathStyle}" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource IconRefresh}"/><TextBlock Text="{DynamicResource Refresh}" VerticalAlignment="Center"/></StackPanel></Button></Grid>
                <DataGrid x:Name="ProcessesGrid" Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding Processes}" IsReadOnly="True"
                          AutomationProperties.Name="{DynamicResource RunningApplications}"
                          PreviewMouseRightButtonDown="ProcessesGrid_OnPreviewMouseRightButtonDown">
                  <DataGrid.ContextMenu>
                    <ContextMenu x:Name="ProcessesContextMenu" Opened="ProcessesContextMenu_OnOpened" Closed="ProcessesContextMenu_OnClosed"
                                 Style="{StaticResource ThemedContextMenuStyle}">
                      <MenuItem x:Name="OptimizeSelectedApplicationMenuItem"
                                Style="{StaticResource ThemedMenuItemStyle}"
                                Header="{DynamicResource OptimizeThisApplication}"
                                Click="OptimizeSelectedApplication_OnClick" />
                      <MenuItem x:Name="ProtectSelectedApplicationMenuItem"
                                Style="{StaticResource ThemedMenuItemStyle}"
                                Header="{DynamicResource AddApplicationToProtection}"
                                Click="ProtectSelectedApplication_OnClick" />
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Width="1.25*" HeaderStyle="{StaticResource CandidateLeftHeaderStyle}" ElementStyle="{StaticResource CandidateLeftCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Application}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProcessId}" Width="70" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateCenterCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Pid}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Memory}" Width="135" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateMemoryCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource CandidateMemory}" ToolTip="{DynamicResource CandidateMemoryHelp}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding IdleStatus}" Width="150" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}" ElementStyle="{StaticResource CandidateIdleStatusCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource IdleStatusColumn}" /></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTemplateColumn Width="110" HeaderStyle="{StaticResource CandidateCenterHeaderStyle}">
                      <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource ProtectionAndRetention}" /></DataGridTemplateColumn.Header>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ProtectionDetail}">
                            <ContentPresenter Style="{StaticResource RetentionStatusIconPresenterStyle}" Visibility="{Binding HasRetentionIcon, Converter={StaticResource BooleanToVisibilityConverter}}" Content="{Binding}" ContentTemplate="{StaticResource RetentionStatusIconTemplate}" />
                            <TextBlock Text="{Binding Protection}" Style="{StaticResource ProcessRetentionCellTextStyle}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Path}" Width="1.8*" HeaderStyle="{StaticResource CandidateLeftHeaderStyle}" ElementStyle="{StaticResource CandidateLeftCellTextStyle}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Path}" /></DataGridTextColumn.Header></DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="ProtectionPage" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="{DynamicResource ApplicationProtection}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ProtectionDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Height="34" Padding="14,5" ToolTip="{DynamicResource AddRunningHelp}" Click="AddRunningProtected_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CommandIconStyle}" FontSize="14" Margin="0,0,6,0" Text="&#xE710;"/><TextBlock Text="{DynamicResource AddRunning}" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Height="34" Padding="14,5" Margin="8,0,0,0" ToolTip="{DynamicResource AddExeHelp}" Click="AddProtected_OnClick"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CommandIconStyle}" FontSize="14" Margin="0,0,6,0" Text="&#xE8E5;"/><TextBlock Text="{DynamicResource AddExe}" VerticalAlignment="Center"/></StackPanel></Button>
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,16,0,0">
                  <ScrollViewer x:Name="ProtectedGroupsScrollViewer" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ProtectedGroupsList" ItemsSource="{Binding ProtectedApplications}"
                                  HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="4,5">
                          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                          <Grid>
                             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ProtectedInstanceCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding InstanceCount, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource ProtectedProcessCountSuffix}"/></TextBlock>
                              <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionStyle}" Margin="0,3,12,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding ApplicationRuleStatus}" Style="{StaticResource CaptionStyle}" Margin="0,4,12,0"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding ApplicationRuleDetail}" />
                              <TextBlock Text="{Binding ApplicationRuleHistory}" Style="{StaticResource CaptionStyle}" Margin="0,2,12,0"
                                         TextTrimming="CharacterEllipsis" Visibility="{Binding HasApplicationRule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <TextBlock Text="{Binding ApplicationRuleSkip}" Style="{StaticResource CaptionStyle}" Margin="0,2,12,0"
                                         TextTrimming="CharacterEllipsis" Visibility="{Binding HasApplicationRule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock x:Name="ProtectedGroupMemoryText" Grid.Column="1" Text="{Binding Memory}" Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" ToolTip="{Binding Memory}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0" ToolTip="{DynamicResource ProtectedStateHelp}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Text" Value="{DynamicResource ProtectionPartial}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProtectionState}" Value="{x:Static local:ApplicationProtectionState.EntireFamily}">
                                      <Setter Property="Text" Value="{DynamicResource ProtectionEntireFamily}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="3" Tag="{Binding}" Style="{StaticResource ExpandCommandButtonStyle}"
                                    IsEnabled="{Binding IsRunning}" ToolTip="{DynamicResource OptimizeProtectedApplicationOnce}"
                                    Click="OptimizeProtectedGroup_OnClick">
                              <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="15" Text="&#xE768;" />
                            </Button>
                             <ToggleButton Grid.Column="4" Style="{StaticResource ExpandButtonStyle}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}" IsEnabled="{Binding HasExecutables}" ToolTip="{DynamicResource ExpandProtectedExecutables}">
                              <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE76C;" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="&#xE70D;" /></DataTrigger></Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                             </ToggleButton>
                             <Button x:Name="ProtectedGroupRuleMenuButton" Grid.Column="5" Tag="{Binding}" Style="{StaticResource ExpandCommandButtonStyle}"
                                     ToolTip="{DynamicResource ApplicationRuleMenu}" AutomationProperties.Name="{DynamicResource ApplicationRuleMenu}"
                                     PreviewMouseLeftButtonDown="ManagedPopupTrigger_OnPreviewMouseLeftButtonDown" Click="ApplicationRuleMenuButton_OnClick">
                               <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="15" Text="&#xE712;" />
                             </Button>
                             <Popup Style="{StaticResource FadePopupStyle}" Placement="Bottom" PlacementTarget="{Binding ElementName=ProtectedGroupRuleMenuButton}"
                                    StaysOpen="True" AllowsTransparency="True" VerticalOffset="6"
                                    Opened="ApplicationRulePopup_OnOpened"
                                    Closed="ApplicationRulePopup_OnClosed">
                               <Border MinWidth="188" Padding="6" CornerRadius="6" Background="{DynamicResource SurfaceBrush}"
                                       BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                 <StackPanel>
                                   <Button Content="{DynamicResource SetApplicationRule}" Tag="{Binding Tag, ElementName=ProtectedGroupRuleMenuButton}"
                                           Style="{StaticResource PopupMenuButtonStyle}" Click="SetApplicationRule_OnClick" />
                                   <Button Content="{DynamicResource OptimizeProtectedApplicationOnce}" Tag="{Binding Tag, ElementName=ProtectedGroupRuleMenuButton}"
                                           Style="{StaticResource PopupMenuButtonStyle}" Click="OptimizeProtectedGroup_OnClick" />
                                   <Button Content="{DynamicResource EditProtectionRange}" Tag="{Binding Tag, ElementName=ProtectedGroupRuleMenuButton}"
                                           Style="{StaticResource PopupMenuButtonStyle}" Click="EditProtectionGroup_OnClick" />
                                   <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}" />
                                   <Button Content="{DynamicResource RemoveProtection}" Tag="{Binding Tag, ElementName=ProtectedGroupRuleMenuButton}"
                                           Style="{StaticResource PopupMenuButtonStyle}" Click="RemoveProtectedGroup_OnClick" />
                                 </StackPanel>
                               </Border>
                             </Popup>
                             <Button Grid.Column="6" Tag="{Binding}" Style="{StaticResource RowDeleteButtonStyle}"
                                     ToolTip="{DynamicResource RemoveProtection}" Click="RemoveProtectedGroup_OnClick">
                              <Path Style="{StaticResource ButtonIconPathStyle}" Width="16" Height="16" Data="{StaticResource IconTrash}" />
                            </Button>
                          </Grid>
                          <ItemsControl Grid.Row="1" Margin="18,8,0,2" ItemsSource="{Binding Executables}" Style="{StaticResource AnimatedExpansionItemsStyle}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,4">
                                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                  <Grid>
                                     <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource ExpandButtonStyle}" Width="26" Height="26"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}" IsEnabled="{Binding HasProcesses}" ToolTip="{DynamicResource ExpandExecutableProcesses}">
                                      <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE76C;" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Text" Value="&#xE70D;" /></DataTrigger></Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding InstanceCount, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource ProtectedInstancesUnit}"/></TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Memory}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                     <Button Grid.Column="4" Tag="{Binding}" Style="{StaticResource ExpandCommandButtonStyle}" Width="28" Height="28" Margin="6,0,0,0"
                                            IsEnabled="{Binding IsRunning}" ToolTip="{DynamicResource OptimizeProtectedExecutableOnce}"
                                            Click="OptimizeProtectedExecutable_OnClick">
                                      <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="14" Text="&#xE768;" />
                                     </Button>
                                     <Button x:Name="ProtectedExecutableRuleMenuButton" Grid.Column="5" Tag="{Binding}" Style="{StaticResource ExpandCommandButtonStyle}" Width="28" Height="28" Margin="6,0,0,0"
                                             ToolTip="{DynamicResource ApplicationRuleMenu}" AutomationProperties.Name="{DynamicResource ApplicationRuleMenu}"
                                             PreviewMouseLeftButtonDown="ManagedPopupTrigger_OnPreviewMouseLeftButtonDown" Click="ApplicationRuleMenuButton_OnClick">
                                       <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="14" Text="&#xE712;" />
                                     </Button>
                                     <Popup Style="{StaticResource FadePopupStyle}" Placement="Bottom" PlacementTarget="{Binding ElementName=ProtectedExecutableRuleMenuButton}"
                                            StaysOpen="True" AllowsTransparency="True" VerticalOffset="6"
                                            Opened="ApplicationRulePopup_OnOpened"
                                            Closed="ApplicationRulePopup_OnClosed">
                                       <Border MinWidth="188" Padding="6" CornerRadius="6" Background="{DynamicResource SurfaceBrush}"
                                               BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                         <StackPanel>
                                           <Button Content="{DynamicResource SetApplicationRule}" Tag="{Binding Tag, ElementName=ProtectedExecutableRuleMenuButton}"
                                                   Style="{StaticResource PopupMenuButtonStyle}" Click="SetApplicationRuleExecutable_OnClick" />
                                           <Button Content="{DynamicResource OptimizeProtectedExecutableOnce}" Tag="{Binding Tag, ElementName=ProtectedExecutableRuleMenuButton}"
                                                   Style="{StaticResource PopupMenuButtonStyle}" Click="OptimizeProtectedExecutable_OnClick" />
                                         </StackPanel>
                                       </Border>
                                     </Popup>
                                  </Grid>
                                  <ItemsControl Grid.Row="1" Margin="30,4,0,2" ItemsSource="{Binding Processes}" Style="{StaticResource AnimatedExpansionItemsStyle}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Grid Margin="0,2">
                                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionStyle}" />
                                          <TextBlock Grid.Column="1" Text="{Binding Memory}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="ApplicationRulesPage" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource ApplicationRules}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource ApplicationRulesDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button x:Name="NewRunningApplicationRuleButton" Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="{DynamicResource NewRuleFromRunning}" AutomationProperties.Name="{DynamicResource NewRuleFromRunning}" Click="NewRunningApplicationRule_OnClick">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CommandIconStyle}" Text="&#xE8B7;"/><TextBlock Text="{DynamicResource NewRuleFromRunning}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button x:Name="NewApplicationRuleButton" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0"
                            ToolTip="{DynamicResource NewApplicationRule}" AutomationProperties.Name="{DynamicResource NewApplicationRule}" Click="NewApplicationRule_OnClick">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CommandIconStyle}" Text="&#xE710;"/><TextBlock Text="{DynamicResource NewApplicationRule}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ListBox x:Name="ApplicationRulesList" ItemsSource="{Binding ApplicationRules}" Background="Transparent" BorderThickness="0"
                           AutomationProperties.Name="{DynamicResource ApplicationRules}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                              <TextBlock Text="{Binding TargetSummary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetSummary}" />
                              <TextBlock Text="{Binding TriggerSummary}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding LastSkip}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,10,0">
                              <TextBlock Text="{DynamicResource ApplicationRuleNextCheckLabel}" Style="{StaticResource CaptionStyle}" />
