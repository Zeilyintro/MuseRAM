                                    <TextBlock Text="{Binding StableAnchor}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                               ToolTip="{Binding StableAnchorSummaryHelp}" ToolTipService.InitialShowDelay="250"/>
