                                              MouseEnter="StableAnchorSummaryScroller_OnMouseEnter"
                                              MouseLeave="StableAnchorSummaryScroller_OnMouseLeave"
                                              Unloaded="StableAnchorSummaryScroller_OnUnloaded">
