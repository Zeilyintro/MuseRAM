                                  <TextBlock Text="{Binding PostOptimizationWorkingSet}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ScrollViewer x:Name="StableAnchorSummaryScroller" Grid.Column="2"
