                                            <DataTrigger Binding="{Binding StableTrendGlyph}" Value="↑">
                                              <Setter Property="Margin" Value="5,0,0,0"/><Setter Property="MinWidth" Value="14"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StableTrendGlyph}" Value="↓">
                                              <Setter Property="Margin" Value="5,0,0,0"/><Setter Property="MinWidth" Value="14"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text=" · " Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StableUpperLimit}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"
                                               ToolTip="{Binding StableAnchorSummaryHelp}" ToolTipService.InitialShowDelay="250"/>
                                  </StackPanel>
                                </ScrollViewer>
                              </Grid>
                              <ProgressBar Grid.Row="2" Style="{StaticResource AnalysisBarStyle}" Value="{Binding WorkingSetPercent}" />
                              <StackPanel x:Name="SustainedReleaseSummary" Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource SustainedRelease}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text=" · " Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SustainedRelease}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                              </StackPanel>
                              <ProgressBar Grid.Row="6" Style="{StaticResource AnalysisBarStyle}" Foreground="{DynamicResource SuccessBrush}" Value="{Binding SustainedReleasePercent}" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding AverageRebound}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                        ToolTip="{Binding StableSamplesHelp}" ToolTipService.InitialShowDelay="250">
                              <TextBlock Text="{Binding BenefitSamples}" TextAlignment="Center" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding StableSamples}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding LastObserved}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="4" Text="{Binding Suggestion}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" FontWeight="SemiBold" />
                            <Button Grid.Column="5" Tag="{Binding}" Style="{StaticResource RowDeleteButtonStyle}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource ClearApplicationBenefitLearning}"
                                    AutomationProperties.Name="{DynamicResource ClearApplicationBenefitLearning}"
                                    Click="ClearApplicationBenefitLearning_OnClick">
                              <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="16" Text="&#xE74D;" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
