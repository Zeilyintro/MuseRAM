                    <DataGrid.Columns>
                      <DataGridTextColumn Binding="{Binding Application}" Width="*" HeaderStyle="{StaticResource CandidateLeftHeaderStyle}" ElementStyle="{StaticResource CandidateLeftCellTextStyle}">
